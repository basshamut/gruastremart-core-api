# ==============================================
# GRUASTREMART CORE API - Variables de Entorno
# ==============================================
# Copia este archivo a .env y ajusta los valores.
# Todas las propiedades de application.yml se resuelven desde aquí.

# ==============================================
# BASE DE DATOS (MongoDB)
# ==============================================
MONGODB_URI=mongodb+srv://usuario:contrasena@cluster.mongodb.net/gruastremart_db
# URI usada por los tests de integración (Cucumber)
MONGODB_TEST_URL=mongodb+srv://usuario:contrasena@cluster.mongodb.net/gruastremart_db_test

# ==============================================
# CORREO (SMTP)
# ==============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
EMAIL_FORGOT_PASSWORD_LINK=https://gruastremart-spa.vercel.app/reset-password
MAIL_DEBUG=false

# ==============================================
# SUPABASE (autenticación / JWT)
# ==============================================
SUPABASE_SECURITY_SECRET_KEY=your-supabase-secret-key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# ==============================================
# CLOUDINARY (almacenamiento de imágenes)
# ==============================================
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
# Valores posibles: cloudinary | local
IMAGE_STORAGE=cloudinary

# ==============================================
# MAILER (remitente / destinatarios / asuntos)
# ==============================================
MAILER_FROM=your-email@gmail.com
MAILER_TO=tremartca@gmail.com
MAILER_CONTACT_SUBJECT=Nuevo mensaje de contacto
MAILER_DEMAND_SUBJECT=Solicitud de Atención Asignada

# ==============================================
# OBSERVABILIDAD (OpenTelemetry -> SigNoz)
# ==============================================
# Endpoint del colector de SigNoz.
# - Red interna Docker (mismo proyecto/red que SigNoz en Coolify):
#     OTEL_EXPORTER_OTLP_ENDPOINT=http://signoz-otel-collector:4317
#     OTEL_EXPORTER_OTLP_PROTOCOL=grpc
# - Colector expuesto por el proxy de Coolify (URL pública sslip.io, puerto 80):
#     OTEL_EXPORTER_OTLP_ENDPOINT=http://otelcollectorhttp-<hash>.<ip>.sslip.io
#     OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf